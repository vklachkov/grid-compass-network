$COMPACT OPTIMIZE(3)
$TITLE ('CCDLC - Dlc Support Module')

/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*				COMPASS CENTRAL DATA LINK CONTROL
* 
* 				Dlc Machine Support Routines:
*
*				IsAnyMachineActive, IsAnyMachineOperating,
*				IsAnyMachineDeferring, FindUnusedMachine,
*				FindUnusedLinkAddress, FindMachine,
*				FreeUsedMachine.
*
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

DlcSupportModule: DO;
$SAVE NOLIST
$INCLUDE (``ccIncs`CommonDefines.inc~Text~)
$INCLUDE (``ccIncs`MachineDefines.inc~Text~)
$INCLUDE (``ccIncs`MacDefines.inc~Text~)
$INCLUDE (``ccIncs`MemoryDefines.inc~Text~)
$INCLUDE (``ccIncs`DlcMsgDefines.inc~Text~)
$INCLUDE (``ccIncs`DlcFrameDefines.inc~Text~)
$INCLUDE (``ccIncs`GlobalDataModule.inc~Text~)
$INCLUDE (``ccIncs`GeneralModule.inc~Text~)
$INCLUDE (``ccIncs`MacModule.inc~Text~)
$INCLUDE (``ccIncs`UtlModule.inc~Text~)
