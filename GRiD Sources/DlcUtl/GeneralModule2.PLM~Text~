GenSendShortFrame: PROCEDURE (pMachine, ctlField, startTimer) CLEAN;
DCL pMachine			SELECTOR;
DCL (ctlField,
	startTimer)			BYTE;
DCL machine				BASED pMachine generalMachineType;
DCL pDlCB				SELECTOR;
DCL dlcb				BASED pDlCB STRUCTURE (DlCBgenDescriptor,
												DlCBioDataParams);

	pDlCB = GenBuildTransmitRequest (pMachine, machine.linkAddress,
									ctlField, msgNoBufferPtr, NIL, 0);
	
	/* dont need response returned if transmitted ok */
	dlCB.freeDisp = freeMsgIfNoError; 

	/* give mac the request */
	CALL MacTransmitFrame (pDlCB);

	/* start the dlc response timer, if requested */
	IF startTimer THEN
		CALL TmrStartResponseTimeout (pMachine);
END;

