*                       TmrDisableTimer, TmrGetTimerAccess,
*                       TmrFreeTimerAccess, TmrAbortTimerRequest,
*                       TmrAddTimerRequest, TmrCompleteTimerRequests,
*                       TmrTimerProcess,
*                       TmrAbortTimeOut, TmrStartDeferTimeOut,
*                       TmrStartPollTimeOut, TmrStartResponseTimeOut,
*                       TmrStartUserTimeOut.
*
*
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

TimerModule: DO;

