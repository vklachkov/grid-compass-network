{&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
&	VIPC Header Types.
&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&}

TYPE

	IpcHeaderType = RECORD
		ipcFunctionCode:	BYTE;
		toBeFreed:			BOOLEAN;
		Reserved:			LONGINT;
		sourceProcID:		WORD;
		destProcID:			WORD;
		class:				WORD;
		note:				WORD;
		length:				WORD;
		END;


	VipcMessageType	= RECORD
		ipcHeader:		IpcHeaderType;
		msgData:		ARRAY [1..1] OF BYTE;
		END;
	VipcMessagePtr	= ^VipcMessageType;

	VipcMessageWithCreditsType = RECORD
		ipcHeader:		IpcHeaderType;
		controlByte:	BYTE;
		newCredits:		BYTE;
		status:			WORD;
		msgData:		ARRAY [1..1] OF BYTE;
		END;
	VipcMessageWithCreditsPtr = ^VipcMessageWithCreditsType;

	VipcConnectArrivedType = RECORD
		ipcHeader:		IpcHeaderType;
		userClass:		WORD;
		propertyList: 	ARRAY [1..1] OF BYTE;
		END;
	VipcConnectArrivedPtr = ^VipcConnectArrivedType;

	VipcConnectResponseType = RECORD
		ipcHeader:		IpcHeaderType;
		status:			WORD;
		END;
	VipcConnectResponsePtr = ^VipcConnectResponseType;

	VipcConnectRequestType = RECORD
		ipcHeader:		IpcHeaderType;
		pathNameLen:	BYTE;
		pathNameChars:	ARRAY [1..1] OF BYTE;
		END;
	VipcConnectRequestPtr = ^VipcConnectRequestType;

	VipcConnectConfirmType = RECORD
		ipcHeader:		IpcHeaderType;
		status:			WORD;
		END;
	VipcConnectConfirmPtr = ^VipcConnectConfirmType;

	VipcDisconnectArrivedType = RECORD
		ipcHeader:		IpcHeaderType;
		reason:			WORD;
		END;
	VipcDisconnectArrivedPtr = ^VipcDisconnectArrivedType;

	VipcDisconnectResponseType = RECORD
		ipcHeader:		IpcHeaderType;
		END;
	VipcDisconnectResponsePtr = ^VipcDisconnectResponseType;

	VipcDisconnectRequestType = RECORD
		ipcHeader:		IpcHeaderType;
		reason:			WORD;
		END;
	VipcDisconnectRequestPtr = ^VipcDisconnectRequestType;

	VipcDisconnectConfirmType = RECORD
		ipcHeader:		IpcHeaderType;
		status:			WORD;
		END;
	VipcDisconnectConfirmPtr = ^VipcDisconnectConfirmType;

	VipcSetConnStatusRequestType = RECORD
		ipcHeader:		IpcHeaderType;
		propertyList:	ARRAY [1..1] OF BYTE;
		END;
	VipcSetConnStatusRequestPtr = ^VipcSetConnStatusRequestType;

	VipcSetConnStatusResponseType = RECORD
		ipcHeader:		IpcHeaderType;
		status:			WORD;
		END;
	VipcSetConnStatusResponsePtr = ^VipcSetConnStatusResponseType;

	VipcChangeRcvProcessType = RECORD
		fD:				BYTE;	
		length:			WORD;	{ length of property = 3}
		tag:			BYTE;
		procID:			WORD;
		END;

