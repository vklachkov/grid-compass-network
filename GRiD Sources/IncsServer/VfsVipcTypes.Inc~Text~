PUBLIC VIPC;

CONST

	VIPC_Msg					= 0;	{ these are all the same }
	VIPC_Message				= 0;
	VIPC_DataMessage			= 0;

	VIPC_ConnectRequest			= 1;	{ Client Layer to VIPC }
	VIPC_ConnectConfirm			= 2;	{ response from VIPC }

	VIPC_ConnectArrived			= 3;	{ VIPC to client layer }
	VIPC_ConnectResponse		= 4;	{ response from Client layer }

	VIPC_DisconnectRequest		= 5;	{ Client Layer to VIPC }
	VIPC_DisconnectConfirm		= 6;	{ response from VIPC }

	VIPC_DisconnectArrived		= 7;	{ VIPC to client layer }
	VIPC_DisconnectResponse		= 8;	{ response from Client layer }

	VIPC_SignonRequest			= 9;	{ Client layer  to VIPC }
	VIPC_SignonResponse			= 10;	{ response from VIPC }

	VIPC_ValidateUser			= 11;	{ VIPC to Admin }
	VIPC_ValidateResponse		= 12;	{ Response from admin }

	VIPC_UserSignedOff			= 13;	{ VIPC to Admin }

	{ The following should not be used any more 

	VIPC_SetStatusRequest		
	VIPC_SetStatusResponse						 }


	VIPC_GetStatusRequest		= 17;	{ Client layer to VIPC }
	VIPC_GetStatusResponse		= 18;	{ response from VIPC }

	VIPC_SignOffRequest			= 19;	{ Client layer to VIPC }
	VIPC_SignOffResponse		= 20;	{ response from VIPC }

	VIPC_TerminateRequest		= 21;	{ Client layer to VIPC }
	VIPC_TerminateResponse		= 22;	{ response from VIPC }

	VIPC_SetConnStatusRequest 	= 23;	{ Client layer to VIPC }
	VIPC_SetConnStatusResponse	= 24;	{ response from VIPC }

	VIPC_SystemManagementCode	= 85;
	VIPC_OsManagementCode		= 86;

	{ Netork management function codes 90 - 95 } 

	VIPC_DiagnosticMsg			= 201;
$EJ
