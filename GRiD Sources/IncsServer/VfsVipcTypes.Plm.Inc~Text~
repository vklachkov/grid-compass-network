DCL VIPC_Msg					LIT	'0',	/* these are all the same */
	VIPC_Message				LIT '0',
	VIPC_DataMessage			LIT '0',

	VIPC_ConnectRequest			LIT	'1',	/* Client Layer to VIPC */
	VIPC_ConnectConfirm			LIT	'2',	/* response from VIPC */

	VIPC_ConnectArrived			LIT	'3',	/* VIPC to client layer */
	VIPC_ConnectResponse		LIT	'4',	/* response from Client layer */

	VIPC_DisconnectRequest		LIT	'5',	/* Client Layer to VIPC */
	VIPC_DisConnectConfirm		LIT	'6',	/* response from VIPC */

	VIPC_DisconnectArrived		LIT	'7',	/* VIPC to client layer */
	VIPC_DisconnectResponse		LIT	'8',	/* response from Client layer */

	VIPC_SignonRequest			LIT	'9',	/* Client layer  to VIPC */
	VIPC_SignonResponse			LIT	'10',	/* response from VIPC */

	VIPC_ValidateUser			LIT	'11',	/* VIPC to Admin */
	VIPC_ValidateResponse		LIT	'12',	/* Response from admin */

	VIPC_UserSignedOff			LIT	'13',	/* VIPC to Admin */

	/* The following should not be used any more 

	VIPC_SetStatusRequest		
	VIPC_SetStatusResponse						 */


	VIPC_GetStatusRequest		LIT	'17',	/* Client layer to VIPC */
	VIPC_GetStatusResponse		LIT	'18',	/* response from VIPC */

	VIPC_SignOffRequest			LIT	'19',	/* Client layer to VIPC */
	VIPC_SignOffResponse		LIT	'20',	/* response from VIPC */

	VIPC_TerminateRequest		LIT	'21',	/* Client layer to VIPC */
	VIPC_TerminateResponse		LIT	'22',	/* response from VIPC */

	VIPC_SetConnStatusRequest 	LIT '23',	/* Client layer to VIPC */
	VIPC_SetConnStatusResponse	LIT '24';	/* response from VIPC */

DCL	VIPC_SystemManagementCode	LIT '85';
