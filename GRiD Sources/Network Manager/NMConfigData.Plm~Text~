DCL	portInfoFormLabels		(*) BYTE PUB INITIAL(
				'?PhoneLink type~Originate and answer~Originate only~',
																'Answer only~|',
				'?Line type~Switched~Leased~|',
				'#Baud rate~Number(100-19200)~300~1200~1200/2400~2400~4800~',
									'7200~9600~14400~16800~19200~External~|',
				'?Modem type~Hayes Smartmodem 1200~Hayes Smartmodem 2400~',
				/*- next line changed on 11/4/88 for FBI/Hughes by Will Strang*/
							'USRobotics 2400~Other~Hayes Smartmodem 9600~|',
				'$External access code~Access code~',
										'None required (line is external)~|',
				'?Dial type~Pulse~Touch-Tone~|',
				'?Auto dial~Yes~No~|');

DCL	portInfoForm		STRUCTURE
	(
	 form				POINTER,
	 numItems			WORD,
	 labelsAndChoices	POINTER,
	 choiceLines		WORD,
	 rows				(portInfoFormRowSize) BYTE
	)	PUB INITIAL (nullPtr, portInfoFormItemCount, @portInfoFormLabels, 1);

DCL	phonelinkTypeRow	dataRowType PUB AT (@portInfoForm.rows(0)),
	lineTypeRow			dataRowType PUB AT (@portInfoForm.rows(14)),
	baudRateRow			dataRowType PUB AT (@portInfoForm.rows(28)),
