	dialTypeRow			dataRowType PUB AT (@portInfoForm.rows(84));

DCL	prefixStr			(prefixStrLength) BYTE PUB,
	prefix				stringType PUB AT (@prefixStr);

/* Form for entering remote system name and network type. */

DCL	remSystemForm		STRUCTURE
	(
	 form				POINTER,
	 numItems			WORD,
	 labelsAndChoices	POINTER,
	 choiceLines		WORD,
