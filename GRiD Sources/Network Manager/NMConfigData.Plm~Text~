/* Data structures for remote forms and menus. */

/* Tokens. */

DCL	passwordToken		(*) BYTE PUB INITIAL(8, 'Password'),
	optionsToken		(*) BYTE PUB INITIAL(7, 'Options'),
	cardToken			(*) BYTE PUB INITIAL(4, 'Card'),
	portToken			(*) BYTE PUB INITIAL(4, 'Port'),
	serverToken			(*) BYTE PUB INITIAL(6, 'Server'),
	connectionToken		(*) BYTE PUB INITIAL(10, 'Connection'),
	phonelinkToken		(*) BYTE PUB INITIAL(9, 'PhoneLink'),
	gridlinkToken		(*) BYTE PUB INITIAL(8, 'GRiDLink'),
	fiberlinkToken		(*) BYTE PUB INITIAL(13, 'OpticGRiDLink'),
	emptyToken			(*) BYTE PUB INITIAL(5, 'Empty'),
	otherToken			(*) BYTE PUB INITIAL(5, 'Other'),
	networkToken		(*) BYTE PUB INITIAL(7, 'Network'),
	publicToken			(*) BYTE PUB INITIAL(6, 'Public'),
	privateToken		(*) BYTE PUB INITIAL(7, 'Private'),
	leasedToken			(*) BYTE PUB INITIAL(6, 'Leased');

DCL	tokenStr			(maxTokenStrLength) BYTE PUB,
	token				stringType PUB AT (@tokenStr),
	subTokenStr			(maxTokenStrLength) BYTE PUB,
	subToken			stringType PUB AT (@subTokenStr);

/* The password form. */

DCL	passwordFormLabels		(*) BYTE PUB INITIAL('%Password~|'),
	passwordForm			STRUCTURE
	(
	 form					POINTER,
	 numItems				WORD,
	 labelsAndChoices		POINTER,
	 choiceLines			WORD,
	 rows					(passwordFormRowSize) BYTE
	)
		PUB INITIAL (nullPtr, passwordFormItemCount, @passwordFormLabels, 1);

DCL	passwordRow			dataRowStringType PUB AT (@passwordForm.rows(0));

DCL	passwordStr			(passwordStrLength) BYTE PUB,
	password			stringType PUB AT (@passwordStr);

/* The main menu */

DCL	mainMenu		(*) BYTE PUB INITIAL(
					'                  Configure communications~',
					'                  Define a GRiD Server~',
					'                  Customize connections~',
					'                  Change administration password~',
					'Erase    CODE-E   Erase a GRiD Server definition~',
					'Options  CODE-O   GRiDNetwork Manager options~',
					'Transfer CODE-T   Read, write, save~',
					'Quit     CODE-Q   Exit and save all changes~',
					'Cancel   CODE-ESC Exit without saving changes~|');

/* The connection menu */

DCL	connMenu		(*) BYTE PUB INITIAL(
					'Add a connection to a GRiD Server~',
					'Modify a connection to a GRiD Server~',
					'Modify an inconsistent connection~',
					'Erase a connection to a GRiD Server~',
					'Erase an inconsistent connection~|');

/* Menu for selecting a card to configure. */

DCL	cardMenuItems	(512) BYTE PUB;

DCL	cardCmdMenu		(*) BYTE PUB INITIAL(
						'Select port protocols~',
						'Configure port 0~',
						'Configure port 1~',
						'Configure port 2~',
						'Configure port 3~|');

/* Form for entering protocol types for each port on a card. */

DCL	protFormLabels		(*) BYTE PUB INITIAL(
					'?Port 0 protocol~None~PhoneLink~GRiDLink~OpticGRiDLink~|',
					'?Port 1 protocol~None~PhoneLink~GRiDLink~OpticGRiDLink~|',
					'?Port 2 protocol~None~PhoneLink~GRiDLink~OpticGRiDLink~|',
					'?Port 3 protocol~None~PhoneLink~GRiDLink~OpticGRiDLink~|');

DCL	protForm			STRUCTURE
	(
	 form				POINTER,
	 numItems			WORD,
	 labelsAndChoices	POINTER,
	 choiceLines		WORD,
	 rows				(protFormRowSize) BYTE
	)	PUB INITIAL (nullPtr, protFormItemCount, @protFormLabels, 1);

DCL	protocolRow		(4)	dataRowType PUB AT (@protForm.rows(0));

