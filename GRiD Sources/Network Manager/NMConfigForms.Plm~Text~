END EraseConnection;

$EJ
DoChangePassword: PROCEDURE(pCh, pError) CLEAN;

DCL	pCh				POINTER,
	ch				BASED pCh BYTE,
	pError			POINTER,
	error			BASED pError WORD,
	confirmed		BOOLEAN,
	tempPassword	(passwordLength) BYTE;

	password.len, password.dummy = 0;
	passwordRow.currentChoice = 1;
	confirmed = RemoteDataFormConfirmed(remConn, @passwordForm,
				@('Password: Enter new password and confirm'), @ch, @error);
	CALL RemoteMsgClearMessage(remConn);
	IF (error <> eOK) OR (ch <> confirmKey) THEN
		GOTO procExit;
	password.dummy = password.len;
	CALL MOVB(@password.dummy, @tempPassword, password.dummy + 1);

	password.len, password.dummy = 0;
	passwordRow.currentChoice = 1;
	confirmed = RemoteDataFormConfirmed(remConn, @passwordForm,
			@('Password: Enter new password again and confirm'), @ch, @error);
	CALL RemoteMsgClearMessage(remConn);
	IF (error <> eOK) OR (ch <> confirmKey) THEN
		GOTO procExit;
	password.dummy = password.len;
	IF NOT SameStrings(@password.dummy, @tempPassword) THEN
	DO;
		CALL RemoteMsgShowLitError(remConn,
					@('New passwords don''t match. Password not set'));
	
    	GOTO procExit;
	END;

	CALL MOVB(@password.dummy, @nmPassword, password.dummy + 1);
	changed = TRUE;

procExit:
	IF error <> eOk THEN
		CALL LogError(error, 1632, attentionOff);

END DoChangePassword;

$EJ
EditOptions: PROCEDURE(pCh, pError) CLEAN;

DCL	pCh				POINTER,
	ch				BASED pCh BYTE,
	pError			POINTER,
	error			BASED pError WORD,
	confirmed		BOOLEAN;

	CALL InitOptionsForm;
	confirmed = RemoteDataFormConfirmed(remConn, @optionsForm,
						@('Options: Fill in form and confirm'), @ch, @error);
	CALL RemoteMsgClearMessage(remConn);
	IF (error <> eOk) OR (ch <> confirmKey) THEN
		GOTO procExit;
	
	changed = changed OR localAreaCodeRow.changed OR longDistCodeRow.changed OR
							highSpeedRow.changed OR mediumSpeedRow.changed OR
														logFileSizeRow.changed;
	CALL GetAccess(@error);
	CALL CopyOptionsForm;
	CALL FreeAccess(@error);

procExit:
	IF error <> eOk THEN
		CALL LogError(error, 1633, attentionOff);

END EditOptions;

$EJ
ConfirmMsg: PROCEDURE(pMsg, pCh, pError) BOOLEAN CLEAN;

DCL	pMsg			POINTER,
	pCh				POINTER,
	ch				BASED pCh BYTE,
	pError			POINTER,
	error			BASED pError WORD;

	CALL RemoteMsgShowLitMessage(remConn, pMsg);
	ch = RemoteConCharIn(remConn, @error);
	IF error = eOk THEN
	DO;
		CALL RemoteMsgClearMessage(remConn);
		RETURN (ch = confirmKey);
	END;
	ELSE
		RETURN FALSE;

END ConfirmMsg;

$EJ
DoQuit: PROCEDURE(pCh, pError) BOOLEAN CLEAN;

DCL	pCh				POINTER,
	ch				BASED pCh BYTE,
	pError			POINTER,
	error			BASED pError WORD,
	dummy			WORD,
	done			BOOLEAN;

	IF changed THEN
		done = ConfirmMsg(@('Quit: Confirm to save and exit'), @ch, @error);
	ELSE
		done = ConfirmMsg(
			@('Quit: Confirm to exit without saving (unchanged)'),
																@ch, @error);

	IF error <> eOk THEN
	DO;
		ch = confirmKey;
		GOTO procExit;
	END;

	IF ch <> confirmKey THEN GOTO procExit;

	IF changed THEN
	DO;
		CALL RemoteMsgShowLitMessage(remConn,
									@('Saving configuration changes'));
		CALL GetAccess(@dummy);
		CALL CreateConfigFile(@error);
		CALL LogString(NewStringLit(@('Saved configuration changes')));
		CALL FreeAccess(@dummy);
		IF error = eOk THEN changed = FALSE;
		ELSE
			DO;
				CALL RemoteMsgShowDecoded(remConn, error);
				ch = escapeKey;
			END;
	END;

procExit:
	IF error <> eOk THEN
		CALL LogError(error, 1634, attentionOff);
	RETURN (ch = confirmKey);

END DoQuit;

$EJ
DoCancel: PROCEDURE(pCh, pError) BOOLEAN CLEAN;

DCL	pCh				POINTER,
	ch				BASED pCh BYTE,
	pError			POINTER,
	error			BASED pError WORD,
	dummy			WORD,
	done			BOOLEAN;

	IF changed THEN
		done = ConfirmMsg(
		  @('Cancel: Confirm to exit without saving (changed)'), @ch, @error);
	ELSE
		done = ConfirmMsg(
		  @('Cancel: Confirm to exit without saving (unchanged)'), @ch,@error);
	IF error <> eOk THEN
		ch = confirmKey;

	IF (ch = confirmKey) AND changed THEN
	DO;
		CALL GetAccess(@error);
		CALL LogString(NewStringLit(@('Cancelled configuration changes')));
		CALL DeallocateData;
		CALL InitConfig;
		dummy = ReadConfigFile(TRUE, @error);	/* log eFileNotFound */
		CALL FreeAccess(@dummy);
		changed, needsToReboot = FALSE;
	END;

	IF error <> eOk THEN
		CALL LogError(error, 1635, attentionOff);
	RETURN (ch = confirmKey);

END DoCancel;

END NMConfigForms;
