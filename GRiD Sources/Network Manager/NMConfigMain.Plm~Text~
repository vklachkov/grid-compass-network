	portInfoSave(portNum).pConnInfo = portInfo(portIndex).pConnInfo;

END CopyPortFormToSave;

$EJ
/* Create the config file. */

CreateConfigFile: PROCEDURE(pError) CLEAN;

DCL	pError		POINTER,
	error		BASED pError WORD,
	dummy		WORD,
	conn		WORD,
	pServer		POINTER,
	serverInfo	BASED pServer serverInfoType,
	pConn		POINTER,
	connInfo	BASED pConn connInfoType,
	pConnForm	POINTER,
	i			WORD,
	j			WORD,
	hasForm		BOOLEAN;

	conn = AttachAndOpen(@configFile, updateFile, updateAccess, @error);
	IF error <> eOk THEN
		RETURN;

	CALL InitPasswordForm;
	error = WriteToken(conn, @token, nullPtr);
	IF error = eOk THEN
		error = WriteFormValues(conn, @passwordForm);
	IF error <> eOk THEN GOTO procExit;

	CALL InitOptionsForm;
	error = WriteToken(conn, @token, nullPtr);
	IF error = eOk THEN
		error = WriteFormValues(conn, @optionsForm);
	IF error <> eOk THEN GOTO procExit;

	DO i = 0 TO 7;
		IF cardInfo(i).configured THEN
		DO;
			CALL InitCardToken(i);
			error = WriteToken(conn, @token, @subToken);
			IF error = eOk THEN
			DO;
				j = 0;
				DO WHILE (j <= 3) AND (error = eOk);
					CALL InitPortForm(i, j, @hasForm);
					error = WriteToken(conn, @token, nullPtr);
					IF (error = eOk) AND hasForm THEN
						error = WriteFormValues(conn, @portInfoForm);
					j = j + 1;
				END;
			END;
		END;
		IF error <> eOk THEN GOTO procExit;
	END;

	pServer = pServerInfo;
	DO WHILE pServer <> nullPtr;
		CALL InitServerToken(pServer);
		error = WriteToken(conn, @token, @subToken);
		IF error = eOk THEN
		DO;
			IF serverInfo.pComment = nullPtr THEN comment.len = 0;
			ELSE
				CALL CopyString(serverInfo.pComment, @comment);
			commentRow.currentChoice = 1;
			error = WriteFormValues(conn, @commentForm);
			IF (error = eOk) AND serverInfo.isPublic THEN
			DO;
				CALL InitNetForm(pServer, publicNetwork);
				error = WriteToken(conn, @token, @subToken);
				IF error = eOk THEN
					error = WriteFormValues(conn, @netForm);
			END;
			IF (error = eOk) AND serverInfo.isPrivate THEN
			DO;
				CALL InitNetForm(pServer, privateNetwork);
				error = WriteToken(conn, @token, @subToken);
				IF error = eOk THEN
					error = WriteFormValues(conn, @netForm);
			END;
			IF error = eOk THEN
			DO;
				pConn = serverInfo.pConnInfo;
				DO WHILE (pConn <> nullPtr) AND (error = eOk);
					pConnForm = InitConnectionForm(pConn);
					error = WriteToken(conn, @token, @subToken);
					netTypeRow.currentChoice = connInfo.networkType;
					IF error = eOk THEN
						error = WriteFormValues(conn, @netTypeForm);
					IF error = eOk THEN
						error = WriteFormValues(conn, pConnForm);
					IF (error = eOk) AND
							((connInfo.networkType = leasedNetwork) OR
											(NOT connInfo.useAnyPort)) THEN
					DO;
						CALL InitSysPortForm(pConn, connInfo.baudChoice);
						error = WriteFormValues(conn, @sysPortForm);
					END;
					pConn = connInfo.pNext;
				END;
			END;
		END;
		IF error <> eOk THEN GOTO procExit;
		pServer = serverInfo.pNext;
	END;

	CALL OsTruncate(conn, @error);

procExit:
	CALL OsDetach(conn, @dummy);

END CreateConfigFile;

$EJ
/* Customizing connections. */

CustomizeConnections: PROCEDURE(pCh, pError) CLEAN;

DCL pCh			POINTER,
	ch			BASED pCh BYTE,
	pError		POINTER,
	error		BASED pError WORD,
	confirmed	BOOLEAN,
	selection	WORD;

	confirmed = RemoteDataMenuConfirmed(remConn, @connMenu,
			@('Customize connections: Select item and confirm'),
													@selection, @ch, @error);
	CALL RemoteMsgClearMessage(remConn);
	IF error <> eOk THEN
		CALL LogError(error, 1614, attentionOff);

	IF (error = eOk) AND (ch = confirmKey) THEN
	DO CASE (selection - 1);
		CALL AddConnection(@ch, @error);			/* Add connection. */

		CALL ModifyConnection(FALSE, @ch, @error);	/* Modify connection. */

		CALL ModifyConnection(TRUE, @ch, @error);
										/* Modify inconsistent connection. */

		CALL EraseConnection(FALSE, @ch, @error);	/* Erase connection. */

		CALL EraseConnection(TRUE, @ch, @error);
										/* Erase inconsistent connection. */
	END;

END CustomizeConnections;

$EJ
/* Main program. */

Main: PROCEDURE CLEAN;

DCL	error		WORD,
	pid			WORD,
	dummy		WORD,
	selection	WORD,
	ch			BYTE,
	done		BOOLEAN,
	confirmed	BOOLEAN,
	pStr		POINTER,
	str			BASED pStr stringType,
	pMsg		POINTER,
	msg			BASED pMsg stdMessage;

	CALL OsHandleCancel(FALSE);
$IF NOT compassMode
	CALL OsGetCardStatus(nullWord, @dummy, SIZE(dummy), @error);
$ENDIF

	/* Set priority. */

	CALL OsSetPriority(OsWhoAmI, nmMainPriority, @error);

	/* Allocate and initialize access semaphore. */

	accessSema = OsCreateSemaphore(@error);
	IF error = eOk THEN
		CALL OsSignal(accessSema, signalNormal, 0, @error);
	IF error <> eOk THEN
	DO;
		CALL LogError(error, 1615, attentionOn);
		CALL OsExit(0);
	END;

	CALL GetMyServerName(@error);
	IF error <> eOk THEN
	DO;
		CALL LogError(error, 1616, attentionOn);
		myServerName.len, myServerName.dummy = 0;
	END;

	changed = FALSE;
	CALL InitForms;
	CALL InitConfig;
	IF NOT ReadConfigFile(FALSE, @error) THEN	/* don't log eFileNotFound */
	DO;
		CALL InitConfig;
		IF (error = eFileNotFound) OR (error = eDirNotFound) THEN
		DO;
			IF NOT ReadOldConfigFile(@error) THEN
				CALL CreateDefaultConfigInfo;
			CALL CreateConfigFile(@error);
			IF error <> eOk THEN
				CALL LogError(error, 1617, attentionOn);
		END;
		ELSE
			CALL CreateDefaultConfigInfo;
	END;
	CALL SetPortSearchOrder;
	consistent = CheckConsistency(nullPtr);

	/* Initialize log file */

	pLogStr = nullPtr;
	logConn = LogInitLog(@logFile, logFileSize, TRUE, TRUE, TRUE, @error);
	IF error <> eOk THEN
		CALL LogError(error, 1618, attentionOn);

	CALL CreateConfig(@error);	/* Create comm configuration. */

$IF NOT compassMode
	CALL OsRegisterName(@nmConfigName, OsWhoAmI, unRegisterName,@error);
	CALL OsRegisterName(@nmConfigName, OsWhoAmI, registerName, @error);
	IF error <> eOk THEN
		CALL LogError(error, 1619, attentionOn);
$ENDIF
	pid = OsForkProcess(@InterfaceProc, nmIfPriority, FALSE,
														nmIfStackSize, @error);
	CALL OsDelay(500);
	IF error <> eOk THEN
		CALL LogError(error, 1620, attentionOn);

	/* Initialization complete - print version and go to background. */

	pStr = 	ConcatStrings(GetVersionString(OsWhoAmI),
								NewStringLit(@(' of GRiDNetwork Manager')));
	CALL MOVB(@str.chars, @nmVersion, str.len);
	nmVersion(str.len) = '';
	CALL GetAccess(@dummy);
	CALL LogString(pStr);
	CALL LogRealConfig;			/* Log the actual configuration. */
	CALL FreeAccess(@dummy);

$IF NOT compassMode
	CALL TellMessageWaiters(OsWhoAmI, eStayingInBackGround);
$ENDIF

	DO WHILE TRUE;

		done = FALSE;
		DO WHILE NOT done;
			userIdBufferLen = SIZE(userIdBuffer);
			remConn = RemoteConnectToInterface(@userClass, @userIdBuffer,
							@userIdBufferLen, nullPtr, 0, @pMsg, @error);
			IF error = eOk THEN
			DO;
				CALL GetAccess(@dummy);
				CALL LogConnect;
				CALL FreeAccess(@dummy);
				ch = confirmKey;
				IF (error = eOk) AND
								(userClass <> systemAdministratorClass) THEN
				DO WHILE (error = eOk) AND (NOT done) AND (ch = confirmKey);
					done = GoodPassword(@ch, @error);
					IF (error = eOk) AND (NOT done) AND (ch = confirmKey) THEN
					DO;
						CALL GetAccess(@dummy);
						CALL LogString(NewStringLit(@('Illegal password')));
						CALL FreeAccess(@dummy);
						CALL RemoteMsgShowLitError(remconn,
									@('Password incorrect, please reenter'));
					END;
				END;
				ELSE
					IF userClass = systemAdministratorClass THEN
						done = TRUE;
				IF NOT done THEN
					CALL RemoteDisconnectInterface(remConn, error, @dummy);
			END;
			ELSE
				IF error = eRmFormsUnknownMsg THEN
				DO;
					CALL GetAccess(@dummy);
					CALL LogBadReq(pMsg);
					CALL FreeAccess(@dummy);
					IF msg.toBeFreed THEN
						CALL OsFree(pMsg, @error);
				END;
			IF error <> eOk THEN
				CALL LogError(error, 1621, attentionOff);
		END;

		done = FALSE;
		curSystemChoice, curConnChoice = 1;
		pCurSystem, pCurConn = nullPtr;
		modConnWarning, eraseConnWarning = FALSE;
		CALL RemoteMsgClearMessage(remConn);
		DO WHILE (NOT done) AND (error = eOk);

			IF modConnWarning THEN
			DO;
				modConnWarning = FALSE;
				CALL RemoteMsgStackLitMessage(remConn,
							@('WARNING: Active connection was modified'));
			END;
			IF eraseConnWarning THEN
			DO;
				eraseConnWarning = FALSE;
				CALL RemoteMsgStackLitMessage(remConn,
							@('WARNING: Active connection was erased'));
			END;
			IF needsToReboot THEN
				CALL RemoteMsgStackLitMessage(remConn,
											@('Server needs to be restarted'));
			IF NOT consistent THEN
				CALL RemoteMsgStackLitMessage(remConn,
						@('WARNING: Connection(s) affected by configuration'));

			CALL RemoteMsgStackLitMessage(remConn, @nmVersion);
			confirmed = RemoteDataMenuConfirmed(remConn, @mainMenu,
							@('Commands: Select item and confirm'),
													@selection, @ch, @error);
			CALL RemoteMsgClearMessage(remConn);
			IF error <> eOk THEN
			DO;
				CALL LogError(error, 1622, attentionOff);
				GOTO loopExit;
			END;
doSelection:
			IF ch <> confirmKey THEN
			DO;
				selection = noSelection;
				IF ch = eraseKey THEN
					selection = eraseServerSelection;
				ELSE
					IF ch = optionsKey THEN
						selection = optionsSelection;
				ELSE
					IF ch = transferKey THEN
						selection = transferSelection;
				ELSE
					IF ch = quitKey THEN
						selection = quitSelection;
				ELSE
					IF ch = cancelKey THEN
						selection = cancelSelection;
				IF selection <> noSelection THEN
					ch = confirmKey;
				ELSE
					GOTO loopExit;
			END;

			IF ch = confirmKey THEN
			DO CASE (selection - 1);

				CALL ConfigureCommCard(@ch, @error);	/* Configure card. */

				CALL DefineServer(@ch, @error);			/* Add server. */

				CALL CustomizeConnections(@ch, @error);	/* Change connections.*/

				CALL DoChangePassword(@ch, @error);		/* Change password. */

				CALL EraseServer(@ch, @error);			/* Erase server. */

				CALL EditOptions(@ch, @error);			/* Edit options. */

				CALL DoTransfer(@ch, @error);			/* Transfer commands. */

				done = DoQuit(@ch, @error);				/* Quit. */

				done = DoCancel(@ch, @error);			/* Cancel. */
			END;

			IF (error = eOk) AND (ch <> confirmKey) THEN
				GOTO doSelection;
loopExit:
		END;
		CALL RemoteDisconnectInterface(remConn, error, @dummy);
		CALL GetAccess(@dummy);
		IF changed THEN
		DO;
			CALL LogString(NewStringLit(
				@('Configuration aborted - changes not saved')));
			CALL DeallocateData;
			CALL InitConfig;
			dummy = ReadConfigFile(TRUE, @error); /* log eFileNotFound */
			changed, needsToReboot = FALSE;
		END;
		ELSE
			CALL LogString(NewStringLit(@('Configuration ended')));
		CALL FreeAccess(@dummy);
	END;
END Main;

CALL Main;
CALL OsExit(0);

END NMConfigMain;
