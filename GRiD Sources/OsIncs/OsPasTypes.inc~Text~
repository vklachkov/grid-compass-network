PUBLIC OS;

CONST
    oldFileMode = 1;
    updateFileMode = 2;
    newFileMode = 3;

    readAccess = 1;
    writeAccess = 2;
    updateAccess = 3;

    changeType = 1;
    changeSubtype = 2;
    returnType = 41h;
    returnSubType = 42h;
    changeIfNoType = 81h;
    changeIfNoSubtype = 82h;

    seekBackwards = 1;
    seekToHere = 2;
    seekForward = 3;
    seekFromEnd = 4;

    GreenwichMeanTime = 1;
    CompassRelativeTime = 2;

    registerName = 1;
    unRegisterName = 2;

    signalNormal = 1;
    signalEvent = 2;
    signalAllWaiters = 3;

TYPE

    Pointer = ^CHAR;

    MemStatusType =
      RECORD
        freeBytes : LONGINT;
        freeBlocks,
        largestFree : WORD;
        allocBytes : LONGINT;
        allocBlocks,
        largestAlloc : WORD;
      END;

    StatusType = 
      RECORD
        open : BOOLEAN;
        access,
        seek : BYTE;
        filePosition,
        fileLength : LONGINT;
        numPages,
        numAllocatedPages : WORD;
      END;

    TimeType =
      RECORD
        year : WORD; month, day : BYTE;
        hour, minute, second : BYTE;
        tenthOfSec, dayOfWeek : BYTE;
        dayOfYear : WORD;
      END;

    ShortString =
      RECORD
        length : BYTE;
        chars : ARRAY [0..255] OF CHAR;
      END;
