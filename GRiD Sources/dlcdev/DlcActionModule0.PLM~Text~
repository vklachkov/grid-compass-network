/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedure:   SecAcCheckXidP
*
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*    purpose:   Send new station xid request buffer to primary 
*               station in response to xid poll.
*
*    Inputs:    Selector to current state machine control block.
*               Selector to dlc message control block.
*
*    Algorithm:
*     1) Free received message control block.
*     2) Get this stations machine id.
*     3) Build xid frame using machine id and xid format 1,
*        (use new station address since dont care which address
*         is allocated).
*     4)
*
*------------------------------------------------------------------------*/

SecAcCheckXidP: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;

DCL machine		BASED pMachine dlcSecondaryMachineType,
	dlCB		BASED pDlCB STRUCTURE (DlCBgenDescriptor, DlCBIoDataParams);
DCL pXidBuffer	POINTER,
	xidBuffer	BASED pXidBuffer STRUCTURE (xidBufferDesc);

	CALL AcFreeCB(pMachine, pDlCB);
	pXidBuffer = @machine.xidImage;
	CALL CpMachineID(@xidBuffer.xidMachineId); 
	xidBuffer.xidType = xidFormatNumber1;
	xidBuffer.xidAddress = noStationAddress;
	xidBuffer.xidError = 0;

	pDlCB = GenBuildTransmitRequest(pMachine, newStationAddress,
						cXidF, msgWithBufferPtr, pXidBuffer, sizeXid1Format);

	CALL MacTransmitFrame(pDlCB);

END SecAcCheckXidP;
$ENDIF

$EJ
/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedures:  PriAcCheckXmitCmp, SecAcCheckXmitCmp.
*
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*    purpose:   Process frame out completion message.
*
*    Inputs:    SELECTOR to current state machine control block.
*               Selector to dlc message control block.
*
*    Algorithm:
*     1) Get selector to user transmit request message block.
*     2) If transmit status is send in progress then
*         set transmit status to send complete.
*     3) Else call machine failure with bad internal status reason.
*     4) Try to complete and acked and send complete i/o requests:
*      1) Get head of machine acked queue
*      2) If status of message is send complete then return user I/O.
*     5) cause event of check poll.
*     6) If secondary station, then disable transmitter (go tri-state).
*
*------------------------------------------------------------------------*/

$IF primary
PriAcCheckXmitCmp: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;

	CALL AcCheckXmitCmp(pMachine, PDlCB);
	CALL GenCauseEvent(pMachine, priExCheckPoll, 0);

END PriAcCheckXmitCmp;

/*-----------------------------------------------------------------------*/
$ENDIF

$IF secondary
SecAcCheckXmitCmp: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;
DCL dlCB		BASED pDlCB STRUCTURE (DlCBgenDescriptor, DlCBioDataParams);
DCL pBuffer		POINTER;
DCL buffer		BASED pBuffer STRUCTURE (dlcHeaderFormat);

	IF (dlCB.dataLength AND bufferTypeMask) = msgWithBufferPtr THEN
		pBuffer = dlCB.pBuffer;
	ELSE
		pBuffer = @dlCB.pBuffer;
	IF (buffer.ctlField AND fBitMask) <> 0 THEN
		CALL MacDisableTransmitter(dlCB.linkNumber);
	CALL AcCheckXmitCmp(pMachine, PDlCB);
	CALL GenCauseEvent(pMachine, secExCheckPoll, 0);

END SecAcCheckXmitCmp;

/*-----------------------------------------------------------------------*/
$ENDIF

AcCheckXmitCmp: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;

DCL machine		BASED pMachine dlcPrimaryMachineType,
	dlCB		BASED pDlCB STRUCTURE (DlCBgenDescriptor, DlCBioDataParams);
DCL pUserDlCB	SELECTOR,
	userDlCB	BASED pUserDlCB STRUCTURE (DlCBgenDescriptor, DlCBioDataParams);

	IF ((dlCB.msgFormat AND msgDlcFormatMask) = macFrameOutInfo) THEN
	DO;
		pUserDlCB = dlCB.pUserCB;
		IF userDlCB.reqError = intCmpStatusSending THEN
			userDlCB.reqError = intCmpStatusSent;
		ELSE
			CALL GenMachineFailure(pMachine, pDlCB, invalidInternalStatus);
		DO WHILE (((pUserDlCB := machine.ackedQhead(0)) <> null) AND 
									(userDlCB.reqError = intCmpStatusSent));
			pUserDlCB = UtlPopQ(@machine.ackedQhead(0));
			CALL GenReturnUserRequest(pMachine, pUserDlCB, ok);
		END;
	END;
	CALL AcFreeCB(pMachine, pDlCB);

END AcCheckXmitCmp;

$EJ
