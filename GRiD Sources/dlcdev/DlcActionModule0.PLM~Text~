*
*    procedure:   PriAcEndPoll
*
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*    purpose:   Poll timer has expired.
*               Set the condition so that the machine can clean 
*               up current operation and end polling.
*
*    Inputs:    SELECTOR to current state machine control block.
*               Selector to dlc message control block.
*
*    Algorithm:
*     1) set the poll timed out flag to true.
*
*------------------------------------------------------------------------*/

PriAcEndPoll: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;

DCL machine		BASED pMachine dlcPrimaryMachineType,
	dlCB		BASED pDlCB STRUCTURE (DlCBgenDescriptor, DlCBioDataParams);
DCL error		WORD;

	machine.pollTimedOut = TRUE;

END PriAcEndPoll;
$ENDIF

$IF primary
$EJ
/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedure:   PriAcEndExchange
*
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*    purpose:   End the polling sequence of the current machine.
*
*    Inputs:    SELECTOR to current state machine control block.
*
*    Algorithm:
*     1) Abort the response timer (if running).
*     2) disable poll signal to notify remote of end of poll.
*     3) start the machine defer timer.
*     4) reset the outstanding send count to zero.
*     5) Set dlc priority to low dlc priority.
*        (This is here is ensure fairness of round robin with
*         other dlc processes).
*
*------------------------------------------------------------------------*/

PriAcEndExchange: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;

DCL machine		BASED pMachine dlcPrimaryMachineType,
	dlCB		BASED pDlCB STRUCTURE (DlCBgenDescriptor);
DCL error		WORD;

	IF machine.pollOn THEN
		CALL MacDisablePoll(machine.linkNumber);
	CALL TmrStartDeferTimeout(pMachine);
	CALL OsSetPriority(OsWhoAmI, dlcPriority, @error);

END PriAcEndExchange;
$ENDIF

$IF secondary
$EJ
/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedure:   SecAcEndExchange
*
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*    purpose:   This procedure will determine which frame to
*               send to end the current polling sequence.
*
*    Inputs:    SELECTOR to current state machine control block.
*
*    Algorithm:
*     1) If data frame is ready and primary not busy then 
*         build I-f Frame response,
*     2) Else if this station is busy then 
*         send Rnr-f response,
*     3) else send Rr-f response.
*     4) reset the outstanding send count to zero.
*     5) Set dlc priority to low dlc priority.
*
*------------------------------------------------------------------------*/

SecAcEndExchange: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;

DCL machine		BASED pMachine dlcSecondaryMachineType,
	dlCB		BASED pDlCB STRUCTURE (DlCBgenDescriptor),
	dataDlCB	BASED pDlCB STRUCTURE (DlCBgenDescriptor, DlCBIoDataParams);
DCL ctlField	BYTE;

	IF ((NOT machine.remoteBusy) AND (machine.sendQhead(0) <> null)) THEN
		pDlCB = GenBuildUserTransmitRequest(pMachine, fBitOn);
	ELSE
		DO;
			IF MacBusyCondition(machine.linkNumber) THEN
			DO;
				ctlField = cRnrF;
				machine.rnrSendCounter = machine.rnrSendCounter + 1;
			END;
			ELSE
				ctlField = cRrF;
			pDlCB = GenBuildTransmitRequest(pMachine, machine.linkAddress,
											ctlField, msgNoBufferPtr, NIL, 0);
		END;
	CALL MacTransmitFrame(pDlCB);

END SecAcEndExchange;
$ENDIF

$IF primary
$EJ
