/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedure:   PriAcCheckPoll
*
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*    purpose:   This action will determine what the next step in
*               normal information transfer is according to the 
*               current status.
*
*    Inputs:    SELECTOR to state machine control block.
*
*    Outputs:   none.
*
*    SideEffects: Will cause event according to current conditions
*               of the protocol machine. 
*
*    Algorithm:
*     1) If receive and send windows equal 1 (simple compass) then
*      1) If send window not full and remote not busy then
*       1) Cause event of continue poll,
*      2) Else cause event of end poll.
*     2) Else 
*      1) If idle poll so far or poll timer has expired then
*       1) Cause event of end poll,
*      2) Else if no more user data to send or window is full then
*       1) Cause event of start poll,
*      3) Else cause event of continue poll.
*
*------------------------------------------------------------------------*/

PriAcCheckPoll: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;

DCL	machine		BASED pMachine dlcPrimaryMachineType,
	dlCB		BASED pDlCB STRUCTURE (DlCBgenDescriptor, DlCBIoDataParams);

$IF multiFrameIo
	IF ((machine.receiveWindow = 1) AND (machine.sendWindow = 1)) THEN
$ENDIF
	DO;
		/* special case for simple compass GRiDLink system */
		IF (machine.sendCount < machine.sendWindow) AND
											(NOT machine.remoteBusy) THEN
			CALL GenCauseEvent(pMachine, PriExContinuePoll, 0);
		ELSE
			CALL GenCauseEvent(pMachine, PriExEndPoll, 0);
	END;
$IF multiFrameIo
	ELSE
		DO;
			IF (machine.idlePoll OR machine.pollTimedOut) THEN
				CALL GenCauseEvent(pMachine, PriExEndPoll, 0);
			ELSE
				IF ((machine.sendQhead(0) = null) OR
							(machine.sendCount >= machine.sendWindow)) THEN
					CALL GenCauseEvent(pMachine, PriExStartPoll, 0);
			ELSE
				CALL GenCauseEvent(pMachine, PriExContinuePoll, 0);
		END;
$ENDIF
END PriAcCheckPoll;
$ENDIF

$IF secondary
$EJ
/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedure:   SecAcCheckPoll
*
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*    purpose:   This procedure will determine the next step to
*               take in the polling operation.
*
*    Inputs:    SELECTOR to current state machine control block.
*
*    Algorithm:
*     1) If send window is full then cause event of end poll.
*     2) else if send queue is empty then cause event of end poll.
*     3) else cause event of continue poll.
*
*------------------------------------------------------------------------*/

SecAcCheckPoll: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;

DCL machine		BASED pMachine dlcSecondaryMachineType,
	dlCB		BASED pDlCB STRUCTURE (DlCBgenDescriptor),
	dataDlCB	BASED pDlCB STRUCTURE (DlCBgenDescriptor, DlCBIoDataParams);

	IF machine.sendCount = machine.sendWindow THEN
		CALL GenCauseEvent(pMachine, secExEndPoll, 0);
	ELSE
		IF (machine.sendQhead(0) = null) THEN
			CALL GenCauseEvent(pMachine, secExEndPoll, 0);
	ELSE
		CALL GenCauseEvent(pMachine, secExContinuePoll, 0);

END SecAcCheckPoll;
$ENDIF

