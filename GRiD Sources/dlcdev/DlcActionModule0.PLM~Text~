/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedure:   PriAcCheckXid
*
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*    purpose:   Processes Xid frames that are received from 
*               secondary stations.
*
*    Inputs:    SELECTOR to current state machine control block.
*               Selector to dlc message control block.
*
*    outputs:   none.
*
*    SideEffects: If valid new station xid message is recvd, 
*                 then return xid message with station address
*                 is sent and event of new station found is caused.
*
*    Algorithm:
*     1) Save xid image in machine control block.
*     2) If xid format id is 1 or 2 and size is right then
*      1) Abort response timer.
*      2) If machine execution parameter is none zero, then
*       1) Set error in xid response to machine param.
*       2) Cause Event of response time out (to cause next defer T.O.)
*      3) Else
*       1) Set error in xid response to zero (ok).
*       2) Set new link address in xid response and machine control block.
*       3) Enable dynamic defer timeout.
*       4) Cause event of found new station.
*     3) Else if xid format is test format id
*      1) Abort response timer.
*      2) set new link address in xid response and machine control block.
*      3) Enable dynamic defer timeout.
*      4) Cause event of found test station.
*     4) If xid format is short format then
*      1) Log error noting loop back test (This is the case when
*         loop back connector has caused receipt of Server Xid request).
*      2) Delay for 1 second (leaves green test light on).
*     5) Else
*      1) Build xid response.
*      2) Give to MAC.
*      3) Log error if xid response error not ok.
*     6) free the received frame control block.
*
*------------------------------------------------------------------------*/

PriAcCheckXid: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;

DCL machine		BASED pMachine dlcPrimaryMachineType,
	dlCB		BASED pDlCB STRUCTURE (DlCBgenDescriptor, DlCBioDataParams);
DCL pXidDlCB	SELECTOR,
	xidDlCB		BASED pXidDlCB STRUCTURE (DlCBgenDescriptor, DlCBIoDataParams);
DCL pXidBuffer	POINTER,
	xidBuffer	BASED pXidBuffer STRUCTURE (xidBufferDesc);

DCL pRecvBuffer	POINTER,
	recvBuffer	BASED pRecvBuffer STRUCTURE (xidBufferDesc);

DCL error		WORD;

	IF ((dlCB.dataLength AND bufferTypeMask) = msgWithBufferPtr) THEN
    	pRecvBuffer = dlCB.pBuffer;
	ELSE
		pRecvBuffer = @dlCB.pBuffer;

	/* save XID information */
	pXidBuffer = @machine.xidImage;
	CALL MOVB(@recvBuffer.xidMachineId, @xidBuffer.xidMachineId, machineIdSize);
	xidBuffer.xidAddress = machine.newAddress;
	xidBuffer.xidType = recvBuffer.xidType;

	xidBuffer.xidError = eBadVersion;  /* assume error */

	IF (((dlCB.dataLength AND lengthMask) = (sizeXid1Format + dlcHeaderSize))
								AND (recvBuffer.lengthField = sizeXid1Format))
$IF supportSimpleXid
			OR (((dlCB.dataLength AND lengthMask) = 
					(sizeXid1Format + dlcHeaderSize - 2)) AND
							(recvBuffer.lengthField = (sizeXid1Format - 2)))
$ENDIF
																		THEN 
	DO;
		IF (recvBuffer.xidType = xidformatNumber1) OR
								(recvBuffer.xidType = xidformatNumber2) THEN
		DO;
			CALL TmrAbortTimeout(pMachine, tmrResponseTimer);
			IF machine.param = 0 THEN
			DO;
				machine.linkAddress = machine.newAddress;
				xidBuffer.xidAddress = machine.newAddress;
				xidBuffer.xidError = 0;
				machine.deferTime = 100;/* start dynamic defer */
				CALL GenCauseEvent(pMachine, priExFoundNewStation, 0);
			END;
			ELSE
				DO;
					/* Too many stations on link */
					xidBuffer.xidAddress = newStationAddress;
					xidBuffer.xidError = machine.param;
					/* restart defer time out */
					CALL GenCauseEvent(pMachine, priExResponseTimeOut, 0);
				END;
		END;
		ELSE
			IF (recvBuffer.xidType = xidTestFormat) THEN
			DO;
				CALL TmrAbortTimeout(pMachine, tmrResponseTimer);
				IF machine.param = 0 THEN
				DO;
					machine.linkAddress = machine.newAddress;
					xidBuffer.xidAddress = machine.newAddress;
					xidBuffer.xidError = 0;
					machine.deferTime = 100;  /* enable dynamic defer */
					CALL GenCauseEvent(pMachine, priExFoundTestStation,0);
					IF machine.userRequestCB <> null THEN
					DO;
						CALL GenReturnUserRequest(pMachine,
										machine.userRequestCB, eDlcTesting);
						machine.userRequestCB = null;
					END;
				END;
				ELSE
					DO;
						/* Too many stations on link */
						xidBuffer.xidAddress = newStationAddress;
						xidBuffer.xidError = machine.param;
						/* restart defer time out */
						CALL GenCauseEvent(pMachine, priExResponseTimeOut, 0);
					END;
			END;
	END;
$IF XidTest
	IF (dlCB.dataLength AND lengthMask) = dlcShortHeaderSize THEN
	DO;
		/* this is for loop back test */
		CALL OsLogError(1, recXidLoopBackTest,
					SHL(DOUBLE(machine.linkNumber), 8) + 0FFh, @(6,'XidTst'));
		CALL OsDelay(1000);
	END;
	ELSE
$ENDIF
		DO;
			/* send response */
			pXidDlCB = GenBuildTransmitRequest(pMachine, newStationAddress,
							cXid, msgWithBufferPtr, pXidBuffer, sizeXid1Format);
			CALL MacTransmitFrame(pXidDlCB);
			IF xidBuffer.xidError <> 0 THEN
			CALL OsLogError(2, xidBuffer.xidError,
					SHL(DOUBLE(machine.linkNumber), 8) + 0FFh, @(6,'XidErr'));
		END;
	CALL AcFreeCB(pMachine, pDlCB);

END PriAcCheckXid;
$ENDIF

$IF secondary
$EJ
/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedure:   SecAcCheckXid
*
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*    purpose:   Processes Xid Response Frame received from 
*               Primary station from new station poll.
*
*    Inputs:    SELECTOR to current state machine control block.
*               Selector to dlc message control block.
*
*    Algorithm:
*     1) Get this stations machine id.
*     2) Compare with machine id in xid response buffer.
*     3) If xid buffer length, xid format type, and machine id matches then
*      1) Save new station address
*      2) Cause event of got address.
*     4) Free message control block.
*
*------------------------------------------------------------------------*/

SecAcCheckXid: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;

DCL machine		BASED pMachine dlcSecondaryMachineType,
	dlCB		BASED pDlCB STRUCTURE (DlCBgenDescriptor, DlCBioDataParams);
DCL pRecvBuffer	POINTER,
	recvBuffer	BASED pRecvBuffer STRUCTURE (xidBufferDesc);
DCL machineId	(8) BYTE;

	CALL CpMachineID(@machineId);

	IF ((dlCB.dataLength AND bufferTypeMask) = msgWithBufferPtr) THEN
		pRecvBuffer = dlCB.pBuffer;
	ELSE
		pRecvBuffer = @dlCB.pBuffer;

	IF (((dlCB.dataLength AND lengthMask) = (sizeXid1Format + dlcHeaderSize))
							AND (recvBuffer.lengthField = sizeXid1Format)) THEN
	DO;
		IF (recvBuffer.xidType = xidformatNumber1) THEN
		DO;
			IF (CMPB (@machineId, @recvBuffer.xidMachineId,
												SIZE(machineId)) = null) THEN
			DO;
				machine.linkAddress = recvBuffer.xidAddress;
				CALL GenCauseEvent(pMachine, secExGotAddress, 0);
			END;
		END;
	END;
	CALL AcFreeCB(pMachine, pDlCB);

END SecAcCheckXid;
$ENDIF

