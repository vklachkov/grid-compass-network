/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedure:   PriAcCheckRetries
*
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*    purpose:   Check The retry counter.
*
*    Inputs:    SELECTOR to current state machine control block
*         and selector to dlc message control block.
*
*    outputs:   none.
*
*    sideEffects: Cause event of retries ok if retry counter
*         less than or equal to maximum retries, else
*         cause event of max retries.
*
*    Algorithm:
*     1) deccrement machine retry counter
*     2) if retries equal zero then
*      1) cause event of retries exhausted.
*      2) reset retry counter.
*     3) else
*      1) cause event of retries ok.
*
*------------------------------------------------------------------------*/

PriAcCheckRetries: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;

DCL machine		BASED pMachine dlcPrimaryMachineType,
	dlCB		BASED pDlCB STRUCTURE (DlCBgenDescriptor, DlCBioDataParams);
DCL error		WORD;
DCL event		BYTE;

	/*	used to determine which machine error counter to increment,
		limit of six counters) */
DCL errorArray	(*) WORD DATA (
					eDlcResponseTimeOut,
					eDlcInvalidRecvdNs,
					eDlcInvalidRecvdNr,
					eDlcUnproductiveRecv,
					eDlcUnproductiveSend,
					eDlcBadLength);
DCL index		WORD;

	error = machine.param;
	index = FindW(@errorArray, error, 6);
	IF index < maxDlcErrorCounters THEN
		machine.errorCounters(index) = machine.errorCounters(index) + 1;
	IF machine.currentRetries = 0 THEN
	DO;
		event = priExRetriesExhausted;
		machine.currentRetries = machine.maxRetries;
	END;
	ELSE 
		DO;
			/* max value means retry forever */
			IF machine.currentRetries < 0FFh THEN
				machine.currentRetries = machine.currentRetries - 1;
			event = priExRetriesOk;
		END;
	machine.idlePoll = TRUE; /* force idle condition */
	CALL GenCauseEvent(pMachine, event, error);

END PriAcCheckRetries;
$ENDIF

