/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedures:  PriAcFreeCB, SecAcFreeCB
*
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*    purpose:   Free the dlc message control block.
*
*    Inputs:    SELECTOR to current state machine control block,
*               (may be null).
*               Selector to dlc message control block.
*
*    Algorithm:
*     1) If selector to message control block is null, then return.
*     2) If message is Dlc type then
*      1) If message is Dlc receive then
*       1) Set up for MAC receive, set msg format to Mac Receive,
*           set source and dest Pid to current process id, and
*           set length to maximum buffer length.
*       2) Queue at MAC.
*      2) Else if message is any other valid dlc message type then
*       1) return to user with error ok.
*      3) Else return to user with error of invalid request type.
*     3) Else if message is Mac type then
*      1) If message is Mac receive then
*       1) Set up for MAC receive, set msg format to Mac Receive,
*           set source and dest Pid to current process id, and
*           set length to maximum buffer length.
*       2) Queue at MAC.
*      2) Else if message is mac frame out then
*       1) Free buffer if any is associated with control block.
*       2) Free message control block.
*     4) Else if message is timer type then
*      1) free message control block.
*     5) Else return user request with error of invalid request type.
*
*------------------------------------------------------------------------*/
$IF primary

PriAcFreeCB: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;

	CALL AcFreeCB(pMachine, pDlCB);

END PriAcFreeCB;

/*-----------------------------------------------------------------------*/
$ENDIF
$IF secondary

SecAcFreeCB: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;

	CALL AcFreeCB(pMachine, pDlCB);

END SecAcFreeCB;

/*-----------------------------------------------------------------------*/
$ENDIF

$IF Primary OR Secondary OR commonActionsOnly
/* moved here to allow simple compilation */

AcFreeCB: PROCEDURE(pMachine, pDlCB) CLEAN;

DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;
DCL machine		BASED pMachine dlcPrimaryMachineType,
	dlCB		BASED pDlCB STRUCTURE (DlCBgenDescriptor, DlCBioDataParams);
DCL reQueueRecv	BYTE;
DCL msgFormat	WORD;
DCL	error		WORD;

	IF pDlCB = null THEN RETURN; /* do nothing */

	reQueueRecv = FALSE;
	msgFormat = dlCB.msgFormat;
	IF (msgFormat AND msgClassMask) = classDlc THEN
	DO;
		IF (msgFormat AND msgDlcFormatMask) = dlcReceive THEN
		DO;
			reQueueRecv = TRUE;
		END;
		ELSE
			IF ((msgFormat AND msgDlcCaseMask) < maximumUserMessageFormat) THEN
			DO;
				CALL GenReturnUserRequest(pMachine, pDlCB, ok);
			END;
		ELSE
			CALL GenReturnUserRequest(pMachine, pDlCB, eDlcInvalidRequest);
			/* should anything else be done ??? */
	END;
	ELSE
		IF (msgFormat AND msgClassMask) = classMac THEN
		DO;
			IF (msgFormat AND msgMacFormatMask) = macFrameReceive THEN
			DO;
				reQueueRecv = TRUE;
			END;
			ELSE
				IF (msgFormat AND msgMacFormatMask) = macFrameOut THEN
				DO;
					IF (dlCB.dataLength AND bufferTypeMask) =
													msgWithBufferPtr THEN
						CALL OsFree(dlCB.pBuffer, @error);
					pDlCB = UtlFreeCB(pDlCB);
				END;
			ELSE
				pDlCB = UtlFreeCB(pDlCB);
		END;
	ELSE
		IF (msgFormat AND msgClassMask) = classTimer THEN
		DO;
			pDlCB = UtlFreeCB(pDlCB);
		END;
	ELSE
		CALL GenReturnUserRequest(pMachine, pDlCB, eDlcInvalidRequest);

	IF reQueueRecv THEN
	DO;
		/* remember where it came from */
		dlCB.sourcePID = OsWhoAmI;
		dlCB.destPID = OsWhoAmI;
		/* set mac type */
		dlCB.msgFormat = macFrameReceive OR msgRequest;
		dlCB.dataLength = (dlCB.dataLength AND bufferTypeMask) OR 0;
		CALL MacReceiveFrame(pDlCB);
	END;

END AcFreeCB;
$ENDIF

