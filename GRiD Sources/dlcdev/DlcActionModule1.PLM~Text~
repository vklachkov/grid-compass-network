/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedures:  PriAcFioFlushed, SecAcFioFlushed.
*
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*    purpose:   The frame io, if any, has been aborted.
*               Now start the user io flushing process.
*
*    Inputs:    SELECTOR to current state machine control block.
*
*    Algorithm:
*     1) Set Mac io flag aborted to true.
*     2) If all flush conditions have been satisfied then
*         Cause event of flush done.
*
*------------------------------------------------------------------------*/

$IF primary
PriAcFioFlushed: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;
DCL machine		BASED pMachine dlcPrimaryMachineType;

	machine.fioAborted = TRUE;
	IF GenIsFlushDone(pMachine) THEN
		CALL GenCauseEvent(pMachine, priExFlushDone, 0);

END PriAcFioFlushed;

/*-----------------------------------------------------------------------*/
$ENDIF
$IF secondary

SecAcFioFlushed: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;
DCL machine		BASED pMachine dlcPrimaryMachineType;

	machine.fioAborted = TRUE;
	IF GenIsFlushDone(pMachine) THEN
		CALL GenCauseEvent(pMachine, secExFlushDone, 0);

END SecAcFioFlushed;

/*-----------------------------------------------------------------------*/
$ENDIF

