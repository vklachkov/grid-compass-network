/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedure:   PriAcInvalidAction, SecAcInvalidAction
*
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*
*    purpose:   Called when state machine executioner can't find
*               a valid action entry point.
*
*    Inputs:    SELECTOR to current state machine control block.
*               Selector to dlc message control block.
*
*    Algorithm:
*     1) log the machine failure condition.
*     2) free msg control block.
*
*------------------------------------------------------------------------*/
$IF primary
PriAcInvalidAction: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;

DCL machine		BASED pMachine dlcPrimaryMachineType,
	dlCB		BASED pDlCB STRUCTURE (DlCBgenDescriptor);

	CALL GenMachineFailure(pMachine, pDlCB, invalidAction);
	CALL AcFreeCB(pMachine, pDlCB);

END PriAcInvalidAction;
$ENDIF

$IF secondary
/*-----------------------------------------------------------------------*/

SecAcInvalidAction: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;

	CALL GenMachineFailure(pMachine, pDlCB, invalidAction);
	CALL AcFreeCB(pMachine, pDlCB);

END SecAcInvalidAction;
$ENDIF

