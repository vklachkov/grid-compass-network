/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedure:   SecAcProcessConnect
*
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*    purpose:   Remote primary has granted the connection.
*               Positively Reply to primary and report
*               success to user.
*
*    Inputs:    SELECTOR to current state machine control block.
*               Selector to dlc message control block.
*
*    Algorithm:
*     1) Free received message control block.
*     2) Abort response timer.
*     3) If user Connect request is pending then
*         Return user request.
*     4) Transmit Unsequenced acknowledgement frame response.
*
*------------------------------------------------------------------------*/

SecAcProcessConnect: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;

DCL machine		BASED pMachine dlcSecondaryMachineType,
	dlCB		BASED pDlCB STRUCTURE (DlCBgenDescriptor);

	CALL AcFreeCB(pMachine, pDlCB); /* free recvd frame CB */
	CALL TmrAbortTimeout(pMachine, tmrUserTimer);
	pDlCB = machine.userRequestCB;
	IF pDlCB <> null THEN
	DO;
		CALL GenReturnUserRequest(pMachine, pDlCB, ok);
		machine.userRequestCB = null;
	END;
	pDlCB = GenBuildTransmitRequest(pMachine, machine.LinkAddress,
											cUaF, msgNoBufferPtr, NIL, 0);
	CALL MacTransmitFrame(pDlCB);

END SecAcProcessConnect;
$ENDIF

$EJ
/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedure:   PriAcProcessInfo, SecAcProcessInfo
*
*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*
*    purpose:   This action processes the received information
*               frame, including checking the N(r) and N(s), and
*               possibly returning the completion to the client.
*
*    Inputs:    SELECTOR to state machine control block.
*               Selector to the dlc receive message control block.
*
*    Algorithm:
*     1) Process received acknowledgement and info frame.
*     2) If error is ok then
*         Cause event of check poll.
*     3) Else cause event of invalid receive with appropriate error.
*     4) If error is not retryAck (translated to eDlcUnProductiveSend) then
*         free received message control block.
*
*------------------------------------------------------------------------*/
$IF primary

PriAcProcessInfo: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;
DCL machine		BASED pMachine dlcPrimaryMachineType;
DCL error		WORD;

	error = AcProcessInfo(pMachine, pDlCB);
	IF error = validNs THEN 
	DO;
		machine.currentRetries = machine.maxRetries;
		CALL GenCauseEvent(pMachine, priExCheckPoll, 0);
	END;
	ELSE
		DO;
			IF error = invalidNr THEN error = eDlcInvalidRecvdNr;
			ELSE
				IF error = invalidNs THEN error = eDlcInvalidRecvdNs;
			ELSE
				IF error = wrongNs THEN error = eDlcUnProductiveRecv;
			ELSE
				IF error = retryAck THEN error = eDlcUnProductiveSend;
			ELSE
				IF error = lengthError THEN error = eDlcBadLength;
			CALL GenCauseEvent(pMachine, PriExRecvdInvalid, error);
			IF error <> eDlcUnProductiveSend THEN
				CALL AcFreeCB(pMachine, pDLCB);
		END;

END PriAcProcessInfo;

/*-----------------------------------------------------------------------*/
$ENDIF
$IF secondary

SecAcProcessInfo: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;
DCL error		WORD;

	error = AcProcessInfo(pMachine, pDlCB);
	IF ((error = invalidNs) OR (error = invalidNr)) THEN
	DO;
		IF error = invalidNr THEN error = eDlcInvalidRecvdNr;
		ELSE
			IF error = invalidNs THEN error = eDlcInvalidRecvdNs;
		CALL GenCauseEvent(pMachine, secExCmdrReason, error);
		CALL AcFreeCB(pMachine, pDLCB);
	END;
	ELSE
		CALL GenCauseEvent(pMachine, secExCheckPoll, 0);

END SecAcProcessInfo;

/*-----------------------------------------------------------------------*/
$ENDIF

AcProcessInfo: PROCEDURE(pMachine, pDlCB) WORD REENTRANT;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;
DCL machine		BASED pMachine dlcPrimaryMachineType,
	dlCB		BASED pDlCB STRUCTURE (DlCBgenDescriptor, DlCBioDataParams);

DCL error		WORD;
DCL recvLength	WORD;
DCL pBuffer		POINTER;
DCL buffer		BASED pBuffer STRUCTURE (dlcHeaderFormat);
DCL recvdNs		BYTE;

/*
  1) Process received acknowledgement.
  2) If error is valid N(r) or retry Ack then
   1) If length error in received info frame then
    1) Count Mac length error.
    2) Set error to length error.
   2) Else if received N(s) is equal expected V(r) then
    1) Return received info frame to user.
    2) Increment V(r).
   3) else if received N(s) is within receive window then
    1) error = wrong N(s).
    2) Count Mac error as missed frame.
   4) Else error = invalid N(s).
  3) IF error is ok then
      Set Idle poll to false, since something was received.
*/

	error = AcProcessAck(pMachine, pDlCB);
	IF (error = validNr) OR (error = retryAck) THEN
	DO;
		recvLength = dlCB.dataLength AND lengthMask;
		IF (dlCB.dataLength AND bufferTypeMask) = msgWithBufferPtr THEN
			pBuffer = dlCB.pBuffer;
		ELSE
			pBuffer = @dlCB.pBuffer;
		IF ((recvLength >= dlcHeaderSize) AND (recvLength <> 
									(buffer.lengthField + dlcHeaderSize))) THEN
		DO;
			error = MacCountError(dlCB.linkNumber, fiCmpBadSize);
			error = lengthError;   /* ignore mac error code */
		END;
		ELSE
			DO;
				recvdNs = SHR((buffer.ctlField AND nsMask), 1);
				IF recvdNs = machine.Vr THEN
				DO;
					dlCB.msgFormat = dlcReceive;
					dlCB.stationNumber = machine.stationNumber;
					dlCB.dataLength = (dlCB.dataLength AND bufferTypeMask) 
												OR (recvLength - dlcHeaderSize);
					CALL GenReturnUserRequest(pMachine, pDlCB, ok);
					machine.Vr = (machine.Vr + 1) MOD dlcModulo;
				END;
				ELSE
					DO;
						IF recvdNs < machine.vr THEN
							recvdNs = recvdNs + dlcModulo;
						IF recvdNs > machine.vr + machine.receiveWindow THEN
						DO;
							/* outside of receive window */
							error = invalidNs;
						END;
						ELSE 
							DO;
								/* inside window, but missed frame(s) */
								error = MacCountError(dlCB.linkNumber,
														fiCmpOutOfSequence);
								error = wrongNs;  /* ignore mac error code */
							END;
					END;
			END;
	END;

	IF error = validNr THEN
	DO;
		machine.idlePoll = FALSE;
		error = validNs;
	END;
	RETURN error;

END AcProcessInfo;

$EJ
/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedure:   PriAcProcessNoBuf, SecAcProcessNoBuf
*
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*
*    purpose:   This action processes the received information
*               frame without buffer, including checking the
*               N(r). The primary machine is set busy.
*
*    Inputs:    SELECTOR to state machine control block.
*               Selector to the dlc receive message control block.
*
*    Algorithm:
*     1) Process received acknowledgement.
*     2) If error is ok then cause event of check poll,
*     3) Else cause event of received invalid with appropriate error.
*     4) Free received message control block.
*     5) Set idle poll flag, to delay next poll.
*
*------------------------------------------------------------------------*/

$IF primary
PriAcProcessNoBuf: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;
DCL machine		BASED pMachine dlcPrimaryMachineType;
DCL error		WORD;

	error = AcProcessAck(pMachine, pDlCB); 
	IF error = validNr THEN
	DO;
		machine.currentRetries = machine.maxRetries;
		CALL GenCauseEvent(pMachine, priExCheckPoll, 0);
	END;
	ELSE
		DO;
			IF error = invalidNr THEN error = eDlcInvalidRecvdNr;
			ELSE
				IF error = retryAck THEN error = eDlcUnproductiveSend;
			CALL GenCauseEvent(pMachine, priExRecvdInvalid, error);
		END;
	CALL AcFreeCB(pMachine, pDLCB);
	machine.idlePoll = TRUE;

END PriAcProcessNoBuf;

/*-----------------------------------------------------------------------*/
$ENDIF
$IF secondary

SecAcProcessNoBuf: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;
DCL machine		BASED pMachine dlcSecondaryMachineType;
DCL error		WORD;

	error = AcProcessAck(pMachine, pDlCB); 
	IF ((error = validNr) OR (error = retryAck)) THEN
		CALL GenCauseEvent(pMachine, secExCheckPoll, 0);
	ELSE
		CALL GenCauseEvent(pMachine, secExCmdrReason, error);
	CALL AcFreeCB(pMachine, pDLCB);
	machine.idlePoll = TRUE;

END SecAcProcessNoBuf;

$ENDIF
$IF primary

$EJ
/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedure:   PriAcProcessNoRsp
*
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*    purpose:   This action processes the response timed out event.
*
*    Inputs:    SELECTOR to state machine control block and 
*
*    Algorithm:
*     1) Process Negative acknowledgement (nothing received).
*     2) Cause event of received invalid, error of response time out.
*     3) Set idle poll flag, to delay next poll.
*
*------------------------------------------------------------------------*/

PriAcProcessNoRsp: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;
DCL machine		BASED pMachine dlcPrimaryMachineType;

	/* zzz dont treat no response as negative response !!!
	DCL error WORD;
	error = AcProcessAck(pMachine, null);
	*/

	CALL GenCauseEvent(pMachine, priExRecvdInvalid, eDlcResponseTimeOut);
	machine.idlePoll = TRUE;
	machine.remoteBusy = TRUE;

END PriAcProcessNoRsp;
$ENDIF

