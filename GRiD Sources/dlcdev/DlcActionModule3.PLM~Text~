/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedure:   PriAcQueueReceive, SecAcQueueReceive
*
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*    purpose:   This Action should not be invoked since all 
*               user receive message control blocks are given
*               directly to MAC (medium Access Control). Left
*               here in case of future changes.
*
*    Inputs:    SELECTOR to current state machine control block.
*               Selector to dlc message control block.
*
*    Algorithm:
*     1) Call AcFreeCB to queue receive request at Mac.
*
*------------------------------------------------------------------------*/
$IF primary

PriAcQueueReceive: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;

	/* Will cause Receive to be queued at Mac */
	CALL AcFreeCB(pMachine, pDlCB);

END PriAcQueueReceive;
$ENDIF
$IF secondary

/*-----------------------------------------------------------------------*/

SecAcQueueReceive: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;

	CALL AcFreeCB(pMachine, pDlCB);

END SecAcQueueReceive;
$ENDIF

/*-----------------------------------------------------------------------*/

AcQueueReceive: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;

	CALL AcFreeCB(pMachine, pDlCB);

END AcQueueReceive;

$EJ
/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedure:   PriAcQueueSend, SecAcQueueSend
*
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*    purpose:   Queue the user send request.
*
*    Inputs:    SELECTOR to current state machine control block.
*               Selector to dlc message control block.
*
*    Algorithm:
*     1) Set the request status to waiting.
*     2) Place request on send queue.
*     3) Preempt the defer timer, if pending.
*
*------------------------------------------------------------------------*/

PriAcQueueSend: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;

DCL machine		BASED pMachine dlcPrimaryMachineType,
	dlCB		BASED pDlCB STRUCTURE (DlCBgenDescriptor);

	dlCB.reqError = intCmpStatusWaiting;
	CALL UtlPutQ(@machine.sendQhead, pDlCB);

	/* preempt current defer timeout to expedite send */
	CALL TmrPreEmptDeferTimeout(pMachine);

END PriAcQueueSend;

$IF secondary
/*-----------------------------------------------------------------------*/

SecAcQueueSend: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;

	CALL PriAcQueueSend(pMachine, pDlCB);

END SecAcQueueSend;
$ENDIF

