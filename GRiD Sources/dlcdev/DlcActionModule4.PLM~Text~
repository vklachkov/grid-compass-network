/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedure:   PriAcStartTestDefer
*
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*    purpose:   This action will start the defer timer, thus
*               causing a delay in further protocol actions
*               and allow process time for other protocol
*               machines. It will also modify the retry count to
*               only retry half the number of time usually tried.
*
*    Inputs:    SELECTOR to machine control block.
*
*    Algorithm:
*     1) disable poll signal, notifying remote of end of poll 
*        condition.
*     2) start the defer timer.
*     3) Divide maxRetries by 2.
*
*------------------------------------------------------------------------*/
$IF primary

PriAcStartTestDefer: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;
DCL machine		BASED pMachine dlcPrimaryMachineType;

	CALL MacDisablePoll(machine.linkNumber);
	machine.maxRetries = SHR(machine.maxRetries, 1);
	CALL TmrStartDeferTimeout(pMachine);

END PriAcStartTestDefer;
$ENDIF

