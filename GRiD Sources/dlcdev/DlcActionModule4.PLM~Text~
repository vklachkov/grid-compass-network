/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedure:   PriAcStartFlush, SecAcStartFlush
*
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*    purpose:   This action will clean up the user io requests
*               after a serious protocol or machine error has
*               occurred.
*
*    Inputs:    SELECTOR to state machine control block.
*
*    Outputs:   none.
*
*    Algorithm:
*     1) If message control block was passed, 
*         then treat as Mac I/o completion.
*     2) If transmit request at end of out queue is still pending
*      1) Return.
*     3) Else set Mac I/O aborted flag to true.
*     4) Disable poll signal.
*     5) Abort all timers.
*     6) Set irrecoverable error code to machine param.
*     7) Set flushing in progress flag to true.
*     8) Set active and deferrring flags to false.
*     9) Check flush done conditions. If flush completed then
*      1) Cause event of flush done.
*     10) Else cause event of Mac I/O aborted.
*
*------------------------------------------------------------------------*/
$IF primary

PriAcStartFlush: PROCEDURE (pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;

DCL machine		BASED pMachine dlcPrimaryMachineType,
	dlCB		BASED pDlCB STRUCTURE (DlCBGenDescriptor);

	IF pDlCB <> null THEN CALL AcCheckXmitCmp(pMachine, pDlCB);

	IF machine.outstandingQhead(0) <> null THEN
	DO;
		/* look at end of queue */
		pDlCB = machine.outstandingQhead(1);
		IF dlCB.reqError = intCmpstatusSending THEN
		DO;
			/* exit */
			RETURN;
		END;
	END;
	ELSE
		machine.fioAborted = TRUE;

	CALL MacDisablePoll(machine.linkNumber);
	CALL TmrAbortTimeout(pMachine, tmrResponseTimer);
	CALL TmrAbortTimeout(pMachine, tmrPollTimer);
	CALL TmrAbortTimeout(pMachine, tmrDeferTimer);
	machine.irrecError = machine.param;
	machine.flushing = TRUE;
	machine.active = FALSE;
	machine.deferring = FALSE;

	IF GenIsFlushDone(pMachine) THEN
		CALL GenCauseEvent(pMachine, priExFlushDone, 0);
	ELSE
		CALL GenCauseEvent(pMachine, priExFioAborted, 0);

END PriAcStartFlush;
$ENDIF

/*-----------------------------------------------------------------------*/

$IF secondary

SecAcStartFlush: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;
DCL machine		BASED pMachine dlcPrimaryMachineType,
	dlCB		BASED pDlCB STRUCTURE (DlCBGenDescriptor);

	IF pDlCB <> null THEN CALL AcCheckXmitCmp(pMachine, pDlCB);
	IF machine.outstandingQhead(0) <> null THEN 
	DO;
		/* look at end of queue */
		pDlCB = machine.outstandingQhead(1);
		IF dlCB.reqError = intCmpstatusSending THEN
		DO;
			/* exit */
			RETURN;
		END;
	END;
	ELSE
		machine.fioAborted = TRUE;

	CALL TmrAbortTimeout(pMachine, tmrPollTimer);
	CALL MacDisableTransmitter(machine.linkNumber);

	machine.irrecError = machine.param;
	machine.flushing = TRUE;
	machine.active = FALSE;
  	machine.deferring = FALSE;

	IF GenIsFlushDone(pMachine) THEN
		CALL GenCauseEvent(pMachine, secExFlushDone, 0);
	ELSE
		CALL GenCauseEvent(pMachine, secExFioAborted, 0);

END SecAcStartFlush;
$ENDIF

$EJ
/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedure:   PriAcShutDown, SecAcShutDown
*
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*    purpose:   Disable the machine and clean up resources.
*
*    Inputs:    SELECTOR to state machine control block.
*               Selector to the user flush request.
*
*    Algorithm:
*     1) Set machine operating flag to false (machine is now dead).
*     2) Return user message control block.
*
*------------------------------------------------------------------------*/
$IF primary

PriAcShutDown: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;
DCL machine		BASED pMachine dlcPrimaryMachineType;

	machine.operating = FALSE;
	CALL GenReturnUserRequest(pMachine, pDlCB, ok);

END PriAcShutDown;
$ENDIF

/*-----------------------------------------------------------------------*/

$IF secondary

SecAcShutDown: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;
DCL machine		BASED pMachine dlcPrimaryMachineType;

	machine.operating = FALSE;
	CALL GenReturnUserRequest(pMachine, pDlCB, ok);

END SecAcShutDown;
$ENDIF

$EJ
/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedure:   PriAcUserFlushed, SecAcUserFlushed
*
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*    purpose:   The user has notified the DLC that he has received
*         the flush indication. The Dlc will now check to
*         see if all conditions for flush complete are met.
*
*    Inputs:    SELECTOR to state machine control block.
*               Selector to the user flush request.
*
*    Algorithm:
*     1) Save user flush request message control block.
*     2) Set user flushed flag to true.
*     3) Check for flush completion, if done then
*         cause event of flush done.
*
*------------------------------------------------------------------------*/
$IF primary

PriAcUserFlushed: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;
DCL machine		BASED pMachine dlcPrimaryMachineType;

	machine.userFlushCB = pDlCB;
	machine.userFlushed = TRUE;
	IF GenIsFlushDone(pMachine) THEN
		CALL GenCauseEvent(pMachine, priExFlushDone, 0);

END PriAcUserFlushed;
$ENDIF
$IF secondary

/*-----------------------------------------------------------------------*/

SecAcUserFlushed: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;
DCL machine		BASED pMachine dlcPrimaryMachineType;

	machine.userFlushCB = pDlCB;
	machine.userFlushed = TRUE;
	IF GenIsFlushDone(pMachine) THEN
		CALL GenCauseEvent(pMachine, secExFlushDone, 0);

END SecAcUserFlushed;
$ENDIF

