/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedure:   PriAcSendPoll
*
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*    purpose:   This action will initiate the polling sequence
*               of a Compass workstation.
*
*    Inputs:    SELECTOR to state machine control block.
*
*    Algorithm:
*     1) Increase dlc priority during polling operation.
*     2) set idle poll flag to true, poll Signal On flag to false.
*     3) If version type is 2 Then
*      1) If data to send then
*       1) Send Rr or Rnr not-P frame followed by I not-p frame.
*       2) Set idle poll flag to false.
*      2) Send Rr-P or Rnr-P frame.
*      3) start response timer.
*     3) Else if receive and send windows equal one (simple compass) then
*      1) If data to send then
*       1) Enable poll signal.
*       2) Set poll signal on flag to true.
*      2) If local busy then send Rnr-P
*      3) Else send Rr-P dlc frame.
*      4) Start response timeout.
*     4) Else (incomplete for multiframe i/o).
*
*------------------------------------------------------------------------*/
$IF primary

PriAcSendPoll: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;
DCL machine		BASED pMachine dlcPrimaryMachineType;
DCL error		WORD;
DCL pXidBuffer	POINTER,
	xidBuffer	BASED pXidBuffer STRUCTURE (xidBufferDesc);

	machine.idlePoll = TRUE;
	machine.pollOn = FALSE;
	machine.sendCount = 0;
	/* if dlc version 2 then can send I-frame as part of poll */
	pXidBuffer = @machine.xidImage;
	IF xidBuffer.xidType = xidFormatNumber2 THEN
	DO;
$IF multiFrameIo
		IF ((machine.sendQhead(0) <> null) AND (NOT machine.remoteBusy)) THEN
$ELSE
		IF ((machine.sendQhead(0) <> null) AND (machine.outstandingQhead(0)
									= null) AND (NOT machine.remoteBusy)) THEN
$ENDIF
		DO;
			/* first send short frame without p-flag set */
			IF MacBusyCondition(machine.linkNumber) THEN
			DO;
				CALL GenSendShortFrame(pMachine, cRnr, FALSE);
				machine.rnrSendCounter = machine.rnrSendCounter + 1;
			END;
			ELSE
				CALL GenSendShortFrame(pMachine, cRr, FALSE);

			/* now send I-frame without p-flag set */
$CODE
			CALL Time(longPktDelay);
$NOCODE
			pDlCB = GenBuildUserTransmitRequest(pMachine, pBitOff);
			CALL MacTransmitFrame(pDlCB);
			machine.idlePoll = FALSE;
		END;
		IF MacBusyCondition(machine.linkNumber) THEN
		DO;
			CALL GenSendShortFrame(pMachine, cRnrP, TRUE);
			machine.rnrSendCounter = machine.rnrSendCounter + 1;
		END;
		ELSE
			CALL GenSendShortFrame(pMachine, cRrP, TRUE);
	END;
	ELSE
$IF multiFrameIo
		IF machine.receiveWindow = 1 AND machine.sendWindow = 1 THEN
$ENDIF
		DO;
			/* only turn on poll signal if something to send or
				possible retry, shortens compass interrupt time. */
			/* enable p-done if I-frame to send */
			IF (machine.sendQhead(0) <> null) THEN
			DO;
				machine.pollOn = TRUE;
				CALL OsSetPriority(OsWhoAmI, dlcHiPriority, @error);
				CALL MacEnablePoll(machine.linkNumber);
			END;
            /* if busy, send RNR-P, else send RR-P */
			IF MacBusyCondition(machine.linkNumber) THEN
			DO;
				CALL GenSendShortFrame(pMachine, cRnrP, TRUE);
				machine.rnrSendCounter = machine.rnrSendCounter + 1;
			END;
			ELSE
				CALL GenSendShortFrame(pMachine, cRrP, TRUE);
		END;
$IF multiFrameIo
	ELSE
		DO;
			CALL MacEnablePoll(machine.linkNumber);
			IF MacBusyCondition(machine.linkNumber) THEN
			DO;
				CALL GenSendShortFrame(pMachine, cRnrP, TRUE);
				machine.rnrSendCounter = machine.rnrSendCounter + 1;
			END;
			ELSE
				IF ((machine.sendQhead(0) <> null)
										AND (NOT machine.remoteBusy)) THEN
				DO;
					pDlCB = GenBuildUserTransmitRequest(pMachine, pBitOff);
					CALL MacTransmitFrame(pDlCB);
				END;
			ELSE
				CALL GenSendShortFrame(pMachine, cRrP, TRUE);
		END;
$ENDIF

	IF machine.pollTime = 0 THEN
	DO;
		machine.pollTimedOut = TRUE;
	END;
	ELSE
		DO;
			machine.pollTimedOut = FALSE;
			CALL TmrStartPollTimeOut(pMachine);
		END;

END PriAcSendPoll;
$ENDIF

$EJ
/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedure:   PriAcSendNext
*
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*    purpose:   This action will continue the transmissions to
*         a Compass workstation, determining what the 
*         appropriate frame should be.
*
*    Inputs:    SELECTOR to state machine control block.
*
*    Outputs:   none.
*
*    Algorithm:
*     1) If receive and send window equal one (simple compass) then
*      1) If poll signal is on and idle poll so far then
*          Send info frame.
*      2) Else cause event of end poll.
*     2) Else multiframe i/o case (not completed).
*
*------------------------------------------------------------------------*/
$IF primary

PriAcSendNext: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;
DCL machine		BASED pMachine dlcPrimaryMachineType,
	dlCB		BASED pDlCB STRUCTURE (DlCBgenDescriptor);

$IF multiFrameIo
	IF machine.receiveWindow = 1 AND machine.sendWindow = 1 THEN
$ENDIF
	DO;
		IF ((machine.pollon) AND (machine.idlePoll) AND
			(machine.sendQhead(0) <> null) AND (NOT machine.remoteBusy)) THEN
		DO;
			machine.idlePoll = FALSE;
			pDlCB = GenBuildUserTransmitRequest(pMachine,pBitOff);
			CALL MacTransmitFrame(pDlCB);
		END;
		ELSE
			CALL GenCauseEvent(pMachine, priExEndPoll, 0);
	END;
$IF multiFrameIo
	ELSE
		IF machine.remoteBusy THEN
		DO;
			IF MacBusyCondition(machine.linkNumber) THEN
			DO;
				pDlCB = GenBuildTransmitRequest(pMachine, machine.linkAddress,
												cRnr, msgNoBufferPtr, NIL, 0);
				machine.rnrSendCounter = machine.rnrSendCounter + 1;
			END;
			ELSE
				pDLCB = GenBuildTransmitRequest(pMachine, machine.linkAddress,
												cRr, msgNoBufferPtr, NIL, 0);
			machine.idlePoll = TRUE;
		END;
	ELSE
		IF machine.sendQhead(0) <> null THEN
		DO;
			IF (pDlCB := machine.outstandingQHead(1)) <> null
								AND (dlCB.reqError <> intCmpStatusSending) THEN
			DO;
				pDlCB = GenBuildUserTransmitRequest(pMachine, pBitOff);
				machine.idlePoll = FALSE;
			END;
			ELSE
				DO;
					pDLCB = GenBuildTransmitRequest(pMachine,
							machine.linkAddress, cRr, msgNoBufferPtr, NIL, 0);
					machine.idlePoll = TRUE;
				END;
		END;
	ELSE
		DO;
			pDLCB = GenBuildTransmitRequest(pMachine, machine.linkAddress,
												cRr, msgNoBufferPtr, NIL, 0);
			machine.idlePoll = TRUE;
		END;

	IF pDlCB <> null THEN
	DO;
		CALL MacTransmitFrame(pDlCB);
		CALL TmrStartResponseTimeout(pMachine);
	END;
$ENDIF

END PriAcSendNext;
$ENDIF

$EJ
/*@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
*
*    procedure:   SecAcSendNext
*
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*/

/*
*    purpose:   Determine what to send next during poll.
*
*    Inputs:    SELECTOR to state machine control block,
*
*    Algorithm:
*     1) If something to send and remote not busy then
*      1) Send user info-F frame.
*     2) Else if local station is out of receive buffers then
*      1) Send Rnr-F frame.
*     3) Else send Rr-F frame.
*
*------------------------------------------------------------------------*/
$IF secondary

SecAcSendNext: PROCEDURE(pMachine, pDlCB) CLEAN;
DCL pMachine	SELECTOR,
	pDlCB		SELECTOR;
DCL machine		BASED pMachine dlcSecondaryMachineType,
	dlCB		BASED pDlCB STRUCTURE (DlCBgenDescriptor, DlCBioDataParams);

	IF (machine.sendQhead(0) <> null) AND (NOT machine.remoteBusy) THEN
		pDlCB = GenBuildUserTransmitRequest(pMachine, fBitOff);
	ELSE
		IF MacBusyCondition(machine.linkNumber) THEN
		DO;
			pDlCB = GenBuildTransmitRequest(pMachine, machine.linkAddress,
												cRnr, msgNoBufferPtr, NIL, 0);
			machine.rnrSendCounter = machine.rnrSendCounter + 1;
		END;
	ELSE
		pDlCB = GenBuildTransmitRequest(pMachine, machine.linkAddress,
												cRr, msgNoBufferPtr, NIL, 0);
	CALL MacTransmitFrame(pDlCB);

END SecAcSendNext;
$ENDIF

